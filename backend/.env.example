# Copy to .env and adjust values

DEBUG=true
DATABASE_URL=sqlite:///./procurement_intel.db
SEED_DAYS=90

# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/procurement_intel

FRONTEND_URL=http://localhost:5173

# Phase 2: NLP sentiment (FinBERT — model downloads on first use ~400 MB)
SENTIMENT_ENABLED=true

# Phase 2: live data feed keys
FX_API_KEY=            # https://www.exchangerate-api.com  (free tier: 1500 req/month)
NEWSAPI_KEY=           # https://newsapi.org               (free tier: 100 req/day)
# Open-Meteo (weather) requires no key

# SMTP alert notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
