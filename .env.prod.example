# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=procurement_intel
POSTGRES_USER=acl
# IMPORTANT: keep POSTGRES_PASSWORD and the password in DATABASE_URL in sync
POSTGRES_PASSWORD=change_me_to_a_strong_password

# ── Backend ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://acl:change_me_to_a_strong_password@db:5432/procurement_intel
DEBUG=false
# Set this after you get your Cloudflare Tunnel URL
FRONTEND_URL=https://your-tunnel-name.trycloudflare.com

# ── API Keys ──────────────────────────────────────────────────────────────────
FX_API_KEY=your_exchangerate_api_key
FREENEWSAPI_KEY=your_freenewsapi_key

# ── FinBERT ───────────────────────────────────────────────────────────────────
SENTIMENT_ENABLED=true
FINBERT_MODEL_PATH=/app/models/buyer_finbert

# ── SMTP alerts (optional) ────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
